#!/usr/bin/env bash
# pre-commit hook — runs before every commit
# Checks: secrets detection, staged file sanity
# Install: scripts/setup-hooks.sh

set -euo pipefail

RED='\033[0;31m'; YELLOW='\033[1;33m'; GREEN='\033[0;32m'; NC='\033[0m'

echo "pre-commit: running checks..."

# ── 1. Secrets detection ────────────────────────────────────────────────────
# Scans staged files for patterns that look like credentials.
# Add project-specific patterns to SECRETS_PATTERNS below.

SECRETS_PATTERNS=(
  'password\s*=\s*["\x27][^"\x27]{4,}'
  'secret\s*=\s*["\x27][^"\x27]{4,}'
  'api_key\s*=\s*["\x27][^"\x27]{8,}'
  'token\s*=\s*["\x27][^"\x27]{8,}'
  'private_key\s*[=:]\s*["\x27][^"\x27]{8,}'
  'BEGIN (RSA|EC|OPENSSH) PRIVATE KEY'
  'AKIA[0-9A-Z]{16}'          # AWS access key
  'sk-[a-zA-Z0-9]{32,}'       # OpenAI / Anthropic key pattern
)

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -v '^scripts/hooks/')

if [ -n "$STAGED_FILES" ]; then
  FOUND_SECRETS=0
  for pattern in "${SECRETS_PATTERNS[@]}"; do
    MATCHES=$(echo "$STAGED_FILES" | xargs grep -rliE "$pattern" 2>/dev/null || true)
    if [ -n "$MATCHES" ]; then
      echo -e "${RED}✗ Possible secret detected (pattern: $pattern)${NC}"
      echo "$MATCHES" | sed 's/^/  /'
      FOUND_SECRETS=1
    fi
  done

  if [ $FOUND_SECRETS -eq 1 ]; then
    echo -e "${RED}Commit blocked. Remove secrets before committing.${NC}"
    echo "  To skip this check (only if you are certain this is a false positive):"
    echo "  git commit --no-verify"
    exit 1
  fi
fi

# ── 2. Block .env files ─────────────────────────────────────────────────────
ENV_FILES=$(git diff --cached --name-only | grep -E '^\.env$|^\.env\.' | grep -v '\.example$' || true)
if [ -n "$ENV_FILES" ]; then
  echo -e "${RED}✗ .env file staged for commit:${NC}"
  echo "$ENV_FILES" | sed 's/^/  /'
  echo -e "${RED}Commit blocked. Add .env to .gitignore.${NC}"
  exit 1
fi

echo -e "${GREEN}✓ pre-commit passed${NC}"
exit 0
